# Copy to .env (never commit .env) or set these in your host's dashboard.
DJANGO_DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-app.onrender.com
DATABASE_URL=postgres://user:password@host:5432/care_to_share
AI_RATE_LIMIT_PER_MINUTE=20
DJANGO_LOG_LEVEL=INFO
HF_HOME=.hf_cache
# Set to False only for plain-HTTP local deployments (deploy_local.sh does this).
DJANGO_HTTPS=True
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300
